# Copy this file to .env.local and fill in the values below.
# Get your Clerk keys from https://dashboard.clerk.com -> your app -> API Keys.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk's own sign-in/sign-up pages live in this app.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where to send users after they sign in / sign up.
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Supabase — Project Settings -> API.
# The service role key is server-only. Never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth — Google Cloud Console -> APIs & Services -> Credentials.
# GOOGLE_REDIRECT_URI must exactly match one of the Authorized redirect URIs
# on the OAuth client, e.g. http://localhost:3000/api/gmail/callback in dev.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Public base URL of the app. Used for absolute redirects after OAuth.
NEXT_PUBLIC_APP_URL=http://localhost:3000
