# Copy this file to .env.local and fill in the values below.
# Get your Clerk keys from https://dashboard.clerk.com -> your app -> API Keys.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk's own sign-in/sign-up pages live in this app.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where to send users after they sign in / sign up.
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Supabase — Project Settings -> API.
# The service role key is server-only. Never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth — Google Cloud Console -> APIs & Services -> Credentials.
# GOOGLE_REDIRECT_URI must exactly match one of the Authorized redirect URIs
# on the OAuth client, e.g. http://localhost:3000/api/google/callback in dev.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Apple Calendar (iCloud, over CalDAV). There is no OAuth for iCloud
# Calendar, so users paste an app-specific password generated at
# appleid.apple.com. This key encrypts that password before it is stored
# in Supabase. Generate one with: openssl rand -base64 32
# Changing it makes every stored Apple password unreadable — everyone
# would have to reconnect.
APPLE_ENCRYPTION_KEY=

# Anthropic — console.anthropic.com -> API Keys.
# Server-only. Never expose it to the browser. Used to generate the brief.
ANTHROPIC_API_KEY=

# Public base URL of the app. Used for absolute redirects after OAuth.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Alpha Vantage — alphavantage.co/support/#api-key (free tier works for
# development). Only used when a user opts into news in their morning
# brief onboarding question; the app works fine with this unset, that
# section of the brief just won't appear.
ALPHA_VANTAGE_API_KEY=

# Twelve Data — powers the Markets row in the morning brief. Optional;
# without it the brief says so rather than dropping the row silently.
# Free tier: 800 credits/day, 8 requests/min. https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=
